# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib
# NOTE: *.log removed from the list above on 2026-11-05.
# Stata batch-mode logs (code/stata/*.log) are intentionally committed as
# the audit trail for regression output. Be mindful that logs produced by
# other tools (pandoc, etc.) will also be tracked now.

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Research data (never commit raw/processed data)
data/raw/
data/processed/

# Stata artifacts (keep .do files and .log files)
*.dta
*.smcl
*.stpr

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
.quarto/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds
